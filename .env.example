# Copy this file to .env and fill in your own values.
# Never commit the real .env file — it's already in .gitignore.

# ── Required ──────────────────────────────────────────────────────────────

# Google AI Studio API key for Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# ── Core settings (optional, sensible defaults applied) ─────────────────────

# Gemini model to use
MODEL=gemini-2.5-flash

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Root directory the Filesystem and Document Intelligence tools are
# confined to. Defaults to your home directory if unset.
FILESYSTEM_ROOT=

# ── GitHub MCP (optional — enables repos/commits/PRs/issues/code search) ────
# Personal access token: https://github.com/settings/tokens
GITHUB_TOKEN=

# ── Context7 MCP (optional — raises rate limits; works without a key too) ──
# https://context7.com/dashboard
CONTEXT7_API_KEY=

# ── Google Workspace: Gmail, Calendar, Drive, Docs, Sheets (optional) ───────
# OAuth client from Google Cloud Console (Desktop app type):
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost
GOOGLE_API_KEY=

# Encryption key used to encrypt OAuth tokens at rest under ~/.mads/auth/.
# Any long random string works — generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OAUTH_TOKEN_ENCRYPTION_KEY=

# ── YouTube Data API v3 (optional — search, video/channel/playlist info) ───
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# ── Spotify (optional — playback control and search) ────────────────────────
# App from the Spotify Developer Dashboard: https://developer.spotify.com/dashboard
# SPOTIFY_REDIRECT_URI must match EXACTLY what's registered for the app.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback
